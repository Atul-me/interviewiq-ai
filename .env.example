# ========================
# Server Configuration
# ========================
NODE_ENV=development
PORT=5000

# ========================
# MongoDB Atlas
# ========================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_interview_db?appName=Cluster0

# ========================
# JWT Authentication
# ========================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ========================
# AI Configuration
# ========================
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini

# ========================
# File Upload
# ========================
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# ========================
# Client URL (for CORS)
# ========================
CLIENT_URL=http://localhost:5173
